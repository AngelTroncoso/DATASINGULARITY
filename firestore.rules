rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Assets collection
    match /assets/{assetId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && incoming().urn is string && incoming().urn.size() <= 256
        && incoming().name is string && incoming().name.size() <= 100;
      allow delete: if isSignedIn();
    }

    // Simulations collection
    match /simulations/{simulationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().text is string && incoming().text.size() <= 2000
        && incoming().sender in ['user', 'oracle', 'system'];
    }

    // User profiles collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
